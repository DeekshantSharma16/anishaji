# Database. Server-side only: the browser never talks to Supabase in this app,
# so the VITE_SUPABASE_* variables Lovable scaffolds are not needed. Adding
# them back is harmless but publishes your project URL and anon key to every
# visitor's browser for no benefit.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The address this deployment runs at, with no trailing slash. Set it per
# environment: the real domain in production, the preview URL in previews.
# Emails link back here, so a wrong value sends people to the wrong site.
VITE_SITE_URL=https://wellnesswithanisha.com
# Nitro builds for Cloudflare by default. Vercel is normally auto-detected,
# but setting this removes the doubt.
NITRO_PRESET=vercel
# Transactional email (optional in dev, required in production)
RESEND_API_KEY=
MAIL_FROM=Wellness with Anisha <hello@wellnesswithanisha.com>
PRACTICE_INBOX=hello@wellnesswithanisha.com
# Practitioner diary at /admin
ADMIN_PASSCODE=
ADMIN_SESSION_SECRET=
